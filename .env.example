# העתק קובץ זה ל-.env ומלא את הערכים

# נתיב לקבצי ה-credentials של Google
GOOGLE_CREDENTIALS_PATH=credentials/credentials.json
GOOGLE_TOKEN_PATH=credentials/token.json

# תיקיית שמירת חשבוניות
INVOICES_DIR=data/invoices

# תיקיית metadata
METADATA_DIR=data/metadata

# נתיב מסד הנתונים
DB_PATH=data/processed.db

# כמה מיילים לסרוק בכל הרצה (ברירת מחדל: 100)
GMAIL_MAX_RESULTS=100

# כמה ימים אחורה לסרוק (ברירת מחדל: 90)
GMAIL_DAYS_BACK=90

# Walla IMAP
WALLA_USER=gnekola@walla.co.il
WALLA_PASS=YOUR_WALLA_PASSWORD_HERE
WALLA_IMAP_HOST=imap.walla.co.il
WALLA_IMAP_PORT=993
WALLA_DAYS_BACK=90
